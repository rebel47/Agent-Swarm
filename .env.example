# Copy to .env. Keep .env out of version control.
ENVIRONMENT=development
API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
TENANT_ID=default
OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-6-sol
SUBAGENT_MODEL=gpt-6-luna
VERIFICATION_MODEL=gpt-6-sol
SYNTHESIS_MODEL=gpt-6-sol
ORCHESTRATOR_REASONING_EFFORT=medium
SUBAGENT_REASONING_EFFORT=low
VERIFICATION_REASONING_EFFORT=high
SYNTHESIS_REASONING_EFFORT=medium
# Standard short-context USD rates verified 2026-11-16; review account pricing before deployment.
MODEL_POLICIES={"gpt-6-sol":{"input_per_million":2,"output_per_million":10,"cached_input_per_million":0.2,"cache_write_multiplier":1.25,"prompt_caching":"explicit","context_tokens":64000,"max_output_tokens":4096},"gpt-6-luna":{"input_per_million":0.1,"output_per_million":0.5,"cached_input_per_million":0.01,"cache_write_multiplier":1.25,"prompt_caching":"explicit","context_tokens":64000,"max_output_tokens":4096}}
ENABLE_CONTEXT_SUMMARIZATION=true
SUMMARY_TRIGGER_CHARS=16000
CONNECTIVITY_MAX_COST_USD=0.10
POSTGRES_PASSWORD=replace-with-a-generated-alphanumeric-password
DATABASE_URL=postgresql+psycopg://swarm:replace-with-a-generated-alphanumeric-password@localhost:5432/swarm
REDIS_URL=redis://localhost:6379/0
# JSON mapping from workspace aliases to existing absolute directories.
# On Windows use forward slashes, e.g. {"project":"E:/code/project"}.
WORKSPACES={}
# Optional absolute host projects folder mounted read-only by Docker.
# Use forward slashes on Windows. The UI accepts paths inside this folder.
# LOCAL_PROJECTS_PATH=E:/projects
# Native backend only: map allowed local prefixes to actual directories.
LOCAL_REPOSITORY_ROOTS={}
REPOSITORY_GIT_HOSTS=["github.com","gitlab.com","bitbucket.org"]
MAX_REPOSITORY_BYTES=52428800
MAX_REPOSITORY_SNAPSHOTS=20
MAX_REPOSITORY_PREPARATIONS=2
REPOSITORY_PREPARE_SECONDS=120
CORS_ORIGINS=http://localhost:3000
MAX_TOTAL_AGENTS=100
MAX_CONCURRENT_AGENTS=10
MAX_AGENT_DEPTH=5
# Shared mode removes individual token caps and uses administrator turn allowances.
# Set false only when intentionally testing strict, model-requested per-agent limits.
SHARED_AGENT_BUDGET=true
MAX_TOTAL_TOKENS=100000000
MAX_TOTAL_COST_USD=1000
MAX_AGENT_STEPS=200
MAX_AGENT_TOKENS=5000000
MAX_SUPERVISOR_STEPS=400
MAX_ACTIVE_JOBS=20
MAX_JOB_SECONDS=21600
WORKER_SLOTS=10
REQUEST_TIMEOUT_SECONDS=90
LEASE_SECONDS=180
MAX_RETRIES=3
POLL_SECONDS=1
FIXED_AGENT_COUNT=3
ALLOW_GIT_HISTORY=false
STREAM_LLM=false
# Optional OTLP HTTP endpoint, without /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
